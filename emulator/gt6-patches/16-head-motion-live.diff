diff --git a/rpcs3/Emu/RSX/gt6_head_motion.h b/rpcs3/Emu/RSX/gt6_head_motion.h
new file mode 100644
index 000000000..5b9d23fc8
--- /dev/null
+++ b/rpcs3/Emu/RSX/gt6_head_motion.h
@@ -0,0 +1,71 @@
+#pragma once
+
+// GT6: live tuning of the cockpit head motion (EU 1.22 EMAIN).
+//
+// The launcher's "Cockpit Head Motion" game patch makes GT6's crash-reaction neck rig (GTCamera::ImpactBlurCamera:
+// head slide, pitch, yaw and roll around a neck pivot) follow the car's acceleration while driving. It also redirects
+// the yaw and head-slide gain loads, which share their constants with other cameras, to two floats of its own.
+// While that patch is present, the emulator rewrites the gains and the input scale every frame from
+// Video/Head Motion/*, so the home menu sliders change the motion live.
+// Reverse-engineering notes: docs/re/gt6-head-motion.md in the GT6 launcher repository.
+
+#include "Emu/System.h"
+#include "Emu/system_config.h"
+#include "Emu/Memory/vm.h"
+
+namespace rsx::gt6
+{
+	constexpr u32 hm_gate = 0x002F949C;            // b 0x2F950C (stock: lbz r0, 0x1e4(r31), collision gate)
+	constexpr u32 hm_gate_word = 0x48000070;
+	constexpr u32 hm_yaw_load = 0x002F9634;        // lfs f1, -0x7c0(r9) with r9 = 0x1560000 (stock: lfs f1, 0xac(r9))
+	constexpr u32 hm_yaw_load_word = 0xC029F840;
+
+	constexpr u32 hm_clamp_min = 0x0113007C;       // -normaliser: input = clamp(acceleration) / normaliser
+	constexpr u32 hm_clamp_max = 0x01130080;       // +normaliser
+	constexpr u32 hm_pitch = 0x011300A8;           // pitch gain (only used by this rig)
+	constexpr u32 hm_roll = 0x011300B0;            // roll gain (only used by this rig)
+	constexpr u32 hm_yaw = 0x0155F840;             // yaw gain (patch's own slot)
+	constexpr u32 hm_slide = 0x0155F844;           // head slide gain (patch's own slot)
+
+	// GT6's stock values. Must match gt6launcher/head_motion.py.
+	constexpr f32 hm_stock_normaliser = 500.f;
+	constexpr f32 hm_stock_pitch = -1.0471976f;
+	constexpr f32 hm_stock_roll = 0.87266463f;
+	constexpr f32 hm_stock_yaw = 1.3962634f;
+	constexpr f32 hm_stock_slide = -10.f;
+
+	inline bool head_motion_patch_active()
+	{
+		if (Emu.GetTitleID() != "BCES01893")
+		{
+			return false;
+		}
+
+		if (!vm::check_addr(hm_gate, vm::page_readable, 4) || !vm::check_addr(hm_yaw_load, vm::page_readable, 4) ||
+			!vm::check_addr(hm_clamp_min, vm::page_readable, 0x38) || !vm::check_addr(hm_yaw, vm::page_readable, 8))
+		{
+			return false;
+		}
+
+		return vm::read32(hm_gate) == hm_gate_word && vm::read32(hm_yaw_load) == hm_yaw_load_word;
+	}
+
+	// Called once per presented frame
+	inline void update_head_motion()
+	{
+		if (!head_motion_patch_active())
+		{
+			return;
+		}
+
+		const auto& hm = g_cfg.video.head_motion;
+		const f32 normaliser = hm_stock_normaliser / static_cast<f32>(std::max<s64>(1, hm.strength.get()));
+
+		*vm::get_super_ptr<f32>(hm_clamp_min) = -normaliser;
+		*vm::get_super_ptr<f32>(hm_clamp_max) = normaliser;
+		*vm::get_super_ptr<f32>(hm_pitch) = hm_stock_pitch * static_cast<f32>(hm.braking.get()) / 100.f;
+		*vm::get_super_ptr<f32>(hm_roll) = hm_stock_roll * static_cast<f32>(hm.lean.get()) / 100.f;
+		*vm::get_super_ptr<f32>(hm_yaw) = hm_stock_yaw * static_cast<f32>(hm.turn.get()) / 100.f;
+		*vm::get_super_ptr<f32>(hm_slide) = hm_stock_slide * static_cast<f32>(hm.slide.get()) / 100.f;
+	}
+}
