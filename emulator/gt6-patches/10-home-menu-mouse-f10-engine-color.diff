+		page_navigation home_menu_page::handle_mouse(const mouse_event& event, s16 mx, s16 my)
+		{
+			using type = mouse_event::type;
+			constexpr s32 drag_step_px = 12;
+
+			const auto press = [this](pad_button button)
+			{
+				return handle_button_press(button, false, user_interface::m_auto_repeat_ms_interval_default);
+			};
+			const bool left_press = event.kind == type::press && event.button == mouse_left;
+			const bool back_press = event.kind == type::press && (event.button == mouse_right || event.button == mouse_back);
+			const auto is_slider = [](const overlay_element* e) { return dynamic_cast<const home_menu_slider_tag*>(e) != nullptr; };
+			const auto inside = [mx, my](const overlay_element& e) { return mx >= e.x && mx < e.x + e.w && my >= e.y && my < e.y + e.h; };
+
+			if (event.kind == type::release)
+			{
+				m_mouse_dragging = false;
+			}
+
+			// Yes/No dialog: left click accepts, right click cancels
+			if (m_message_box && m_message_box->visible)
+			{
+				if (left_press) return press(pad_button::cross);
+				if (back_press) return press(pad_button::circle);
+				return page_navigation::stay;
+			}
+
+			if (home_menu_page* page = get_current_page(false))
+			{
+				return page->handle_mouse(event, mx, my);
+			}
+
+			// Popup list (dropdowns): wheel moves, left click picks, right click closes
+			if (m_popup && m_popup.input_hook)
+			{
+				if (left_press) return press(pad_button::cross);
+				if (back_press) return press(pad_button::circle);
+				if (event.kind == type::wheel) return press(event.wheel > 0 ? pad_button::dpad_up : pad_button::dpad_down);
+				return page_navigation::stay;
+			}
+
+			switch (event.kind)
+			{
+			case type::press:
+			{
+				if (back_press) return press(pad_button::circle);
+				if (!left_press) return page_navigation::stay;
+
+				if (m_config_changed && *m_config_changed)
+				{
+					if (inside(m_save_btn)) return press(pad_button::square);
+					if (inside(m_discard_btn)) return press(pad_button::triangle);
+					if (show_reset_button() && inside(m_reset_btn)) return press(pad_button::select);
+				}
+
+				const s32 index = entry_at(mx, my);
+				if (index < 0) return page_navigation::stay;
+
+				if (index != get_selected_index())
+				{
+					select_entry(index);
+					play_sound(sound_effect::cursor);
+				}
+
+				if (is_slider(get_selected_entry()))
+				{
+					m_mouse_dragging = true;
+					m_drag_origin_x = mx;
+					m_drag_steps = 0;
+					return page_navigation::stay;
+				}
+
+				return press(pad_button::cross);
+			}
+			case type::move:
+			{
+				if (m_mouse_dragging)
+				{
+					const s32 steps = (mx - m_drag_origin_x) / drag_step_px;
+					page_navigation navigation = page_navigation::stay;
+					for (; m_drag_steps < steps; m_drag_steps++) navigation = handle_button_press(pad_button::dpad_right, true, 10);
+					for (; m_drag_steps > steps; m_drag_steps--) navigation = handle_button_press(pad_button::dpad_left, true, 10);
+					return navigation;
+				}
+
+				// Hover selects
+				const s32 index = entry_at(mx, my);
+				if (index >= 0 && index != get_selected_index())
+				{
+					select_entry(index);
+				}
+				return page_navigation::stay;
+			}
+			case type::wheel:
+			{
+				const s32 index = entry_at(mx, my);
+				if (index >= 0 && is_slider(get_entry(index)))
+				{
+					if (index != get_selected_index()) select_entry(index);
+					return press(event.wheel > 0 ? pad_button::dpad_right : pad_button::dpad_left);
+				}
+				return press(event.wheel > 0 ? pad_button::dpad_up : pad_button::dpad_down);
+			}
+			case type::release:
+				break;
+			}
+
+			return page_navigation::stay;
+		}
+
