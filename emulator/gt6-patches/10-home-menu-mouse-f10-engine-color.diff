diff --git a/rpcs3/Emu/RSX/Overlays/overlay_mouse_input.h b/rpcs3/Emu/RSX/Overlays/overlay_mouse_input.h
new file mode 100644
index 000000000..7345ca645
--- /dev/null
+++ b/rpcs3/Emu/RSX/Overlays/overlay_mouse_input.h
@@ -0,0 +1,87 @@
+#pragma once
+
+// GT6: mouse input for native overlays (the home menu).
+// The game window (Qt) pushes events while an overlay has asked for mouse input; the overlay's input
+// thread drains them. Positions are window pixels (device pixels, same space as the swapchain); the
+// presenter publishes the rectangle the overlays are drawn into so they can be mapped to the overlay's
+// virtual 1280x720 space.
+
+#include "util/types.hpp"
+#include "util/atomic.hpp"
+
+#include <mutex>
+#include <utility>
+#include <vector>
+
+namespace rsx::overlays
+{
+	struct mouse_event
+	{
+		enum class type : u8 { move, press, release, wheel };
+
+		type kind = type::move;
+		u8 button = 0;   // 1 = left, 2 = right, 3 = middle, 4 = back
+		s32 x = 0;       // window device pixels
+		s32 y = 0;
+		s32 wheel = 0;   // notches, positive = away from the user
+	};
+
+	enum mouse_button : u8
+	{
+		mouse_left = 1,
+		mouse_right = 2,
+		mouse_middle = 3,
+		mouse_back = 4,
+	};
+
+	struct mouse_input_queue
+	{
+		atomic_t<bool> active{false};   // an overlay currently consumes mouse input
+
+		void push(const mouse_event& e)
+		{
+			if (!active) return;
+			std::lock_guard lock(m_mutex);
+			if (m_events.size() < 512) m_events.push_back(e);
+		}
+
+		std::vector<mouse_event> take()
+		{
+			std::lock_guard lock(m_mutex);
+			return std::exchange(m_events, {});
+		}
+
+		void clear()
+		{
+			std::lock_guard lock(m_mutex);
+			m_events.clear();
+		}
+
+		// Called by the presenter every frame: where the overlays are drawn, in window device pixels
+		void set_area(s32 x, s32 y, s32 w, s32 h)
+		{
+			m_area_pos = (static_cast<u64>(static_cast<u32>(x)) << 32) | static_cast<u32>(y);
+			m_area_size = (static_cast<u64>(static_cast<u32>(w)) << 32) | static_cast<u32>(h);
+		}
+
+		// Window pixels -> overlay virtual coordinates. False when no frame has been presented yet.
+		bool to_virtual(s32 px, s32 py, u16 virtual_w, u16 virtual_h, s16& vx, s16& vy) const
+		{
+			const u64 pos = m_area_pos, size = m_area_size;
+			const s32 ax = static_cast<s32>(pos >> 32), ay = static_cast<s32>(pos & 0xffffffff);
+			const s32 aw = static_cast<s32>(size >> 32), ah = static_cast<s32>(size & 0xffffffff);
+			if (aw <= 0 || ah <= 0) return false;
+			vx = static_cast<s16>(static_cast<s64>(px - ax) * virtual_w / aw);
+			vy = static_cast<s16>(static_cast<s64>(py - ay) * virtual_h / ah);
+			return true;
+		}
+
+	private:
+		std::mutex m_mutex;
+		std::vector<mouse_event> m_events;
+		atomic_t<u64> m_area_pos{0};
+		atomic_t<u64> m_area_size{0};
+	};
+
+	inline mouse_input_queue g_mouse_input;
+}
