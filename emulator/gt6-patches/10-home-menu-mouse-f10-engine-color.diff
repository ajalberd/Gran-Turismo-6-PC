+// GT6: forward mouse input to the home menu (see Emu/RSX/Overlays/overlay_mouse_input.h)
+static void forward_overlay_mouse_event(QEvent* ev, qreal dpr)
+{
+	using namespace rsx::overlays;
+
+	const auto to_button = [](Qt::MouseButton button) -> u8
+	{
+		switch (button)
+		{
+		case Qt::LeftButton: return mouse_left;
+		case Qt::RightButton: return mouse_right;
+		case Qt::MiddleButton: return mouse_middle;
+		case Qt::BackButton: return mouse_back;
+		default: return 0;
+		}
+	};
+
+	mouse_event e{};
+
+	switch (ev->type())
+	{
+	case QEvent::MouseMove:
+	case QEvent::MouseButtonPress:
+	case QEvent::MouseButtonDblClick:
+	case QEvent::MouseButtonRelease:
+	{
+		const auto* me = static_cast<QMouseEvent*>(ev);
+		e.kind = ev->type() == QEvent::MouseMove ? mouse_event::type::move
+			: ev->type() == QEvent::MouseButtonRelease ? mouse_event::type::release
+			: mouse_event::type::press;
+		e.button = to_button(me->button());
+		const QPointF pos = me->position() * dpr;
+		e.x = static_cast<s32>(pos.x());
+		e.y = static_cast<s32>(pos.y());
+		g_mouse_input.push(e);
+		break;
+	}
+	case QEvent::Wheel:
+	{
+		static int accumulated = 0;
+		const auto* we = static_cast<QWheelEvent*>(ev);
+		accumulated += we->angleDelta().y();
+		const int notches = accumulated / 120;
+		if (!notches) break;
+		accumulated -= notches * 120;
+		e.kind = mouse_event::type::wheel;
+		e.wheel = notches;
+		const QPointF pos = we->position() * dpr;
+		e.x = static_cast<s32>(pos.x());
+		e.y = static_cast<s32>(pos.y());
+		g_mouse_input.push(e);
+		break;
+	}
+	default:
+		break;
+	}
+}
