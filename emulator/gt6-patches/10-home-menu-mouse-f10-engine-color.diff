diff --git a/rpcs3/Emu/RSX/gt6_engine_color.h b/rpcs3/Emu/RSX/gt6_engine_color.h
new file mode 100644
index 000000000..e36f5ce25
--- /dev/null
+++ b/rpcs3/Emu/RSX/gt6_engine_color.h
@@ -0,0 +1,69 @@
+#pragma once
+
+// GT6: live control of the game's own color correction (EU 1.22 EMAIN).
+//
+// The launcher's "Engine Color Correct (experimental)" game patch hooks PDIScene::ColorCorrectRenderer's
+// constructor (0x8C2834) and applies modifiers read from 10 floats at 0x155F800 to the gain, bias, gamma
+// and chroma GT6 sets for the scene. While that hook is present, the emulator rewrites those floats every
+// frame from Video/Color Grading/Engine *, so the home menu sliders change the game's grading live.
+// Reverse-engineering notes: docs/re/gt6-color-pipeline.md in the GT6 launcher repository.
+
+#include "Emu/System.h"
+#include "Emu/system_config.h"
+#include "Emu/Memory/vm.h"
+
+#include <cmath>
+
+namespace rsx::gt6
+{
+	constexpr u32 engine_cc_hook = 0x008C2834;        // patched: b <code cave>   (stock: stfs f1,0x28(r3))
+	constexpr u32 engine_cc_hook_next = 0x008C2838;   // beq cr7, +0x70 in every build we support
+	constexpr u32 engine_cc_hook_next_word = 0x419E0070;
+	constexpr u32 engine_cc_data = 0x0155F800;        // gain rgb, bias rgb, gamma rgb, chroma
+
+	inline bool engine_color_hook_active()
+	{
+		if (Emu.GetTitleID() != "BCES01893")
+		{
+			return false;
+		}
+
+		if (!vm::check_addr(engine_cc_hook, vm::page_readable, 8) || !vm::check_addr(engine_cc_data, vm::page_readable, 40))
+		{
+			return false;
+		}
+
+		// A relative branch at the hook = the patch is applied
+		return (vm::read32(engine_cc_hook) >> 26) == 18 && vm::read32(engine_cc_hook_next) == engine_cc_hook_next_word;
+	}
+
+	// Slider (-100..100, 0 = neutral) -> modifier. Must match gt6launcher/engine_color.py.
+	inline f32 engine_gain(s64 v) { return 1.f + static_cast<f32>(v) / 100.f; }          // 0 .. 2, multiplies
+	inline f32 engine_bias(s64 v) { return static_cast<f32>(v) / 500.f; }                // -0.2 .. 0.2, adds
+	inline f32 engine_gamma(s64 v) { return std::exp2(-static_cast<f32>(v) / 100.f); }   // 2 .. 0.5, multiplies the exponent (+ = brighter)
+	inline f32 engine_chroma(s64 v) { return 1.f + static_cast<f32>(v) / 100.f; }        // 0 .. 2, multiplies
+
+	// Called once per presented frame
+	inline void update_engine_color()
+	{
+		if (!engine_color_hook_active())
+		{
+			return;
+		}
+
+		const auto& cg = g_cfg.video.color_grading;
+		const f32 values[10] =
+		{
+			engine_gain(cg.engine_gain_r.get()), engine_gain(cg.engine_gain_g.get()), engine_gain(cg.engine_gain_b.get()),
+			engine_bias(cg.engine_bias_r.get()), engine_bias(cg.engine_bias_g.get()), engine_bias(cg.engine_bias_b.get()),
+			engine_gamma(cg.engine_gamma_r.get()), engine_gamma(cg.engine_gamma_g.get()), engine_gamma(cg.engine_gamma_b.get()),
+			engine_chroma(cg.engine_chroma.get()),
+		};
+
+		auto* dst = vm::get_super_ptr<f32>(engine_cc_data);
+		for (u32 i = 0; i < 10; i++)
+		{
+			dst[i] = values[i];
+		}
+	}
+}
