+		// ---- GT6: compact adjust view ----
+
+		namespace
+		{
+			constexpr u16 focus_panel_w = 720;
+			constexpr u16 focus_panel_h = 108;
+			constexpr s16 focus_panel_x = (overlay::virtual_width - focus_panel_w) / 2;
+			constexpr s16 focus_panel_y = overlay::virtual_height - focus_panel_h - 36;
+			constexpr s16 focus_margin = 28;
+			constexpr s16 focus_rail_x = focus_panel_x + focus_margin;
+			constexpr s16 focus_rail_y = focus_panel_y + 58;
+			constexpr u16 focus_rail_w = focus_panel_w - 2 * focus_margin;
+			constexpr u16 focus_rail_h = 6;
+			constexpr u16 focus_knob_d = 20;
+
+			bool in_focus_panel(s16 mx, s16 my)
+			{
+				return mx >= focus_panel_x && mx < focus_panel_x + focus_panel_w && my >= focus_panel_y && my < focus_panel_y + focus_panel_h;
+			}
+
+			bool on_focus_rail(s16 mx, s16 my)
+			{
+				return mx >= focus_rail_x - 16 && mx <= focus_rail_x + focus_rail_w + 16 && my >= focus_rail_y - 22 && my <= focus_rail_y + focus_rail_h + 22;
+			}
+		}
