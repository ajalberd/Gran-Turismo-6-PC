diff --git a/rpcs3/Emu/RSX/color_grading.h b/rpcs3/Emu/RSX/color_grading.h
new file mode 100644
index 000000000..c351bb827
--- /dev/null
+++ b/rpcs3/Emu/RSX/color_grading.h
@@ -0,0 +1,169 @@
+#pragma once
+
+// GT6: user color grading for the video-out (calibration) pass.
+//
+// Works on the final display-encoded image (after upscaling, before RPCS3's own overlays):
+//   1. linear stage   c = M * c + offset       white balance, shadows (lift), highlights (gain), brightness
+//   2. gamma          c = pow(c, power)
+//   3. contrast       c = (c - 0.5) * contrast + 0.5
+//   4. saturation     mix(luma, c, saturation), then vibrance (boosts muted colors more than saturated ones)
+//   5. clamp, optional +-0.5 LSB triangular dither (hides 8-bit banding from the curve)
+//
+// The shader receives these packed into the spare lanes of the calibration pass push constants, see
+// VideoOutCalibrationPass.glsl. M is a full 3x3 matrix so it can be folded into the anaglyph matrices.
+
+#include "Utilities/geometry.h"
+#include "Emu/system_config.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace rsx
+{
+	// Bits of the calibration pass "limit_range" int
+	enum video_out_flags : int
+	{
+		video_out_limited_range = 1,
+		video_out_color_grade = 2,
+		video_out_dither = 4,
+	};
+
+	struct color_grading_params
+	{
+		bool enabled = false;
+		bool dither = false;
+		mat3f matrix{};          // column-major, matrix[i] = column i
+		f32 offset[3]{};
+		f32 power = 1.f;
+		f32 contrast = 1.f;
+		f32 saturation = 1.f;
+		f32 vibrance = 0.f;
+
+		// Column-major 3x3 product: out = matrix * in
+		void multiply_into(mat3f& in_out) const
+		{
+			mat3f tmp{};
+			for (int c = 0; c < 3; ++c)
+			{
+				for (int r = 0; r < 3; ++r)
+				{
+					tmp[c].rgb[r] =
+						matrix[0].rgb[r] * in_out[c].rgb[0] +
+						matrix[1].rgb[r] * in_out[c].rgb[1] +
+						matrix[2].rgb[r] * in_out[c].rgb[2];
+				}
+			}
+			for (int c = 0; c < 3; ++c) in_out[c] = tmp[c];
+		}
+	};
+
+	inline color_grading_params get_color_grading_params()
+	{
+		color_grading_params p{};
+		const auto& cfg = g_cfg.video.color_grading;
+		p.enabled = cfg.enabled.get();
+
+		if (!p.enabled)
+		{
+			return p;
+		}
+
+		const auto norm = [](s64 v) { return std::clamp(static_cast<f32>(v) / 100.f, -1.f, 1.f); };
+
+		const f32 temperature = norm(cfg.temperature.get());
+		const f32 tint = norm(cfg.tint.get());
+		const f32 lift = norm(cfg.shadows.get()) * 0.2f;            // +-0.2 at the black point
+		const f32 gain = 1.f + norm(cfg.highlights.get()) * 0.5f;   // 0.5 .. 1.5 at the white point
+		const f32 brightness = norm(cfg.brightness.get()) * 0.2f;   // +-0.2 flat offset
+
+		// White balance: warm = more red / less blue, tint + = magenta (less green).
+		// Normalised to keep Rec.709 luma of white unchanged so it does not change brightness.
+		f32 wb[3] = { 1.f + 0.25f * temperature, 1.f - 0.20f * tint, 1.f - 0.25f * temperature };
+		const f32 luma = 0.2126f * wb[0] + 0.7152f * wb[1] + 0.0722f * wb[2];
+		for (f32& w : wb) w /= luma;
+
+		// c' = gain * ((1 - lift) * WB * c + lift) + brightness
+		for (int i = 0; i < 3; ++i)
+		{
+			p.matrix[i] = {};
+			p.matrix[i].rgb[i] = gain * (1.f - lift) * wb[i];
+			p.offset[i] = gain * lift + brightness;
+		}
+
+		// + brightens midtones (like raising a gamma slider in a TV menu): 0.5x .. 2x
+		p.power = std::exp2(-norm(cfg.gamma.get()));
+		p.contrast = std::exp2(norm(cfg.contrast.get()));
+		p.saturation = 1.f + norm(cfg.saturation.get());
+		p.vibrance = norm(cfg.vibrance.get());
+		p.dither = cfg.dither.get();
+		return p;
+	}
+
+	inline bool is_anaglyph_mode(stereo_render_mode_options mode)
+	{
+		switch (mode)
+		{
+		case stereo_render_mode_options::anaglyph_red_green:
+		case stereo_render_mode_options::anaglyph_red_blue:
+		case stereo_render_mode_options::anaglyph_red_cyan:
+		case stereo_render_mode_options::anaglyph_magenta_cyan:
+		case stereo_render_mode_options::anaglyph_trioscopic:
+		case stereo_render_mode_options::anaglyph_amber_blue:
+		case stereo_render_mode_options::anaglyph_custom:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	// Packs grading into the calibration pass inputs.
+	// left/right: anaglyph matrices (columns, xyz used, w = spare lane), extra: one more spare vec4.
+	// Returns the flag bits to OR into "limit_range".
+	template <typename Vec4>
+	int pack_color_grading(const color_grading_params& p, stereo_render_mode_options stereo_mode, Vec4* left, Vec4* right, Vec4& extra)
+	{
+		if (!p.enabled)
+		{
+			return 0;
+		}
+
+		if (is_anaglyph_mode(stereo_mode))
+		{
+			// The shader already multiplies by the anaglyph matrices: fold M into them
+			mat3f l, r;
+			for (int i = 0; i < 3; ++i)
+			{
+				l[i] = { left[i].x, left[i].y, left[i].z };
+				r[i] = { right[i].x, right[i].y, right[i].z };
+			}
+			p.multiply_into(l);
+			p.multiply_into(r);
+			for (int i = 0; i < 3; ++i)
+			{
+				left[i].x = l[i].r; left[i].y = l[i].g; left[i].z = l[i].b;
+				right[i].x = r[i].r; right[i].y = r[i].g; right[i].z = r[i].b;
+			}
+		}
+		else
+		{
+			// Left matrix is unused outside the anaglyph modes: it carries M
+			for (int i = 0; i < 3; ++i)
+			{
+				left[i].x = p.matrix[i].r; left[i].y = p.matrix[i].g; left[i].z = p.matrix[i].b;
+			}
+		}
+
+		left[0].w = p.offset[0];
+		left[1].w = p.offset[1];
+		left[2].w = p.offset[2];
+		right[0].w = p.power;
+		right[1].w = p.contrast;
+		right[2].w = p.saturation;
+		extra.x = p.vibrance;
+		extra.y = 0.f;
+		extra.z = 0.f;
+		extra.w = 0.f;
+
+		return video_out_color_grade | (p.dither ? video_out_dither : 0);
+	}
+}
